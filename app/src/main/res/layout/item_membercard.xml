<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <!-- Avatar circle -->
        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="RA"
            android:textColor="#5A6472"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Chevron right -->
        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_chevron_right"
            app:tint="#C0C8D2"
            android:contentDescription="View detail" />

        <!-- Content block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tvInitials"
            android:layout_toStartOf="@id/ivChevron"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <!-- Name + badge row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rafiq Ahmed"
                    android:textColor="#0D1B2A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <!-- Status badge -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_active"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Active"
                    android:textColor="#1B6B3A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Room · Phone -->
            <TextView
                android:id="@+id/tvRoomPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room 201 · 017XXXXXXXX"
                android:textColor="#6B7A8D"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <!-- Meals + Due row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meals: "
                    android:textColor="#6B7A8D"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvMeals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28"
                    android:textColor="#0D1B2A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due: "
                    android:textColor="#6B7A8D"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳2,450"
                    android:textColor="#D94040"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>