<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Title row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Add Utility Bill"
                android:textColor="#0D1B2A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseUtility"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />

        </RelativeLayout>

        <!-- BILL TYPE -->
        <TextView
            style="@style/LabelStyle"
            android:text="TYPE OF ENTRY" />

        <Spinner
            android:id="@+id/spinnerEntryType"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp" />

        <TextView
            style="@style/LabelStyle"
            android:text="BILL CATEGORY" />

        <Spinner
            android:id="@+id/spinnerBillType"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp" />

        <!-- AMOUNT -->
        <TextView
            style="@style/LabelStyle"
            android:text="AMOUNT (৳)" />

        <EditText
            android:id="@+id/etAmount"
            style="@style/InputStyle"
            android:hint="e.g. 3200"
            android:inputType="number" />

        <!-- MONTH -->
        <TextView
            style="@style/LabelStyle"
            android:text="MONTH" />

        <EditText
            android:id="@+id/etMonth"
            style="@style/InputStyle"
            android:hint="July 2025"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false" />

        <!-- DUE DATE -->
        <TextView
            style="@style/LabelStyle"
            android:text="DUE DATE" />

        <EditText
            android:id="@+id/etDueDate"
            style="@style/InputStyle"
            android:hint="31 Jul 2025"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false" />

        <!-- Add Bill Button -->
        <Button
            android:id="@+id/btnAddBill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_teal"
            android:text="Add Bill"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
