<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Title row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Add Equipment"
                android:textColor="#0D1B2A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseEquipment"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />

        </RelativeLayout>

        <!-- EQUIPMENT NAME -->
        <TextView
            style="@style/LabelStyle"
            android:text="EQUIPMENT NAME" />

        <EditText
            android:id="@+id/etEquipmentName"
            style="@style/InputStyle"
            android:hint="e.g. Pressure Cooker"
            android:inputType="textCapWords" />

        <!-- LOCATION -->
        <TextView
            style="@style/LabelStyle"
            android:text="LOCATION" />

        <Spinner
            android:id="@+id/spinnerLocation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp" />

        <!-- STATUS -->
        <TextView
            style="@style/LabelStyle"
            android:text="STATUS" />

        <Spinner
            android:id="@+id/spinnerEquipmentStatus"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp" />

        <!-- PURCHASE DATE -->
        <TextView
            style="@style/LabelStyle"
            android:text="PURCHASE DATE" />

        <EditText
            android:id="@+id/etPurchaseDate"
            style="@style/InputStyle"
            android:hint="26 Jul 2025"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false" />

        <!-- PURCHASE PRICE -->
        <TextView
            style="@style/LabelStyle"
            android:text="PURCHASE PRICE (৳)" />

        <EditText
            android:id="@+id/etPurchasePrice"
            style="@style/InputStyle"
            android:hint="e.g. 1200"
            android:inputType="phone" />

        <!-- Add Button -->
        <Button
            android:id="@+id/btnAddEquipmentSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_teal"
            android:text="Add Equipment"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
