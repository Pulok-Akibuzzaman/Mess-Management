<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bazar_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bazar_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Meal &amp; Routine"
        app:titleTextColor="@color/text_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Today's Date -->
            <TextView
                android:id="@+id/tv_today_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuesday, 04 Aug"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Breakfast Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Breakfast" android:textColor="@color/text_dark" android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_b_minus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="-"
                        android:padding="0dp"
                        android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
                        app:backgroundTint="#F44336" />
                    <TextView android:id="@+id/tv_b_count" android:layout_width="50dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textSize="18sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_b_plus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:padding="0dp"
                        android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
                        app:backgroundTint="#4CAF50" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lunch Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lunch" android:textColor="@color/text_dark" android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_l_minus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="-"
                        android:padding="0dp"
                        android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
                        app:backgroundTint="#F44336" />
                    <TextView android:id="@+id/tv_l_count" android:layout_width="50dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textSize="18sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_l_plus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:padding="0dp"
                        android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
                        app:backgroundTint="#4CAF50" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dinner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dinner" android:textColor="@color/text_dark" android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_d_minus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="-"
                        android:padding="0dp"
                        android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
                        app:backgroundTint="#F44336" />
                    <TextView android:id="@+id/tv_d_count" android:layout_width="50dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textSize="18sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_d_plus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:padding="0dp"
                        android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
                        app:backgroundTint="#4CAF50" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Personal Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#1A4F5C"
                app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MY SUMMARY" android:textColor="#A8C8D0" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_my_total_meals" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Total Meals" android:textColor="#A8C8D0" android:textSize="12sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33FFFFFF" android:layout_marginVertical="4dp" />

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tv_my_total_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="৳0" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Meal Cost" android:textColor="#A8C8D0" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <!-- Weekly Routine Title -->
            <TextView
                android:id="@+id/tv_history_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECENT MEAL HISTORY"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:id="@+id/routine_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bottom_nav_background"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:id="@+id/btn_home_layout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" app:tint="@color/nav_inactive" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="@color/nav_inactive" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btn_member_layout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_members" app:tint="@color/nav_inactive" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Members" android:textColor="@color/nav_inactive" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btn_meals_layout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_meals" app:tint="@color/nav_active" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meals" android:textColor="@color/nav_active" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btn_bazar_layout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_bazar" app:tint="@color/nav_inactive" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bazar" android:textColor="@color/nav_inactive" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btn_cash_layout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_cash" app:tint="@color/nav_inactive" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cash" android:textColor="@color/nav_inactive" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btn_more_layout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_more" app:tint="@color/nav_inactive" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More" android:textColor="@color/nav_inactive" android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
