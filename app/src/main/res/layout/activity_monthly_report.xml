<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Monthly Report"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- Grand Total Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1B7A9E"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvReportMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MONTHLY SUMMARY — GRAND TOTAL"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:alpha="0.8"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvGrandTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="৳0"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#FFFFFF"
                        android:alpha="0.15"
                        android:layout_marginBottom="16dp" />

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- Total Meals -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total meals"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:alpha="0.9" />

                            <TextView
                                android:id="@+id/tvTotalMeals"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Vertical Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#FFFFFF"
                            android:alpha="0.25"
                            android:layout_marginHorizontal="10dp" />

                        <!-- Per Meal Rate -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Meal Price"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:alpha="0.9" />

                            <TextView
                                android:id="@+id/tvMealRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৳0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFB74D"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Vertical Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#FFFFFF"
                            android:alpha="0.25"
                            android:layout_marginHorizontal="10dp" />

                        <!-- Members -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Members"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:alpha="0.9" />

                            <TextView
                                android:id="@+id/tvMemberCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Cost Breakdown Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COST BREAKDOWN"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.05" />

            <!-- Cost Items Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Item 1: Bazar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_bazar"
                            android:padding="8dp"
                            android:background="@drawable/pill_background"
                            android:backgroundTint="#F1F5F9"
                            app:tint="#64748B" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bazar (grocery)"
                                    android:textSize="14sp"
                                    android:textColor="#475569" />
                                <TextView
                                    android:id="@+id/tvBazarCost"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="৳0"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#1E293B"
                                    android:layout_alignParentEnd="true" />
                            </RelativeLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/pbBazar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:progress="0"
                                app:trackThickness="5dp"
                                app:trackColor="#EDF2F7"
                                app:indicatorColor="#0D5169"
                                app:trackCornerRadius="10dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Item 2: Utility Bills -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_bolt"
                            android:padding="8dp"
                            android:background="@drawable/pill_background"
                            android:backgroundTint="#FFF8E1"
                            app:tint="#FFB74D" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Utility bills"
                                    android:textSize="14sp"
                                    android:textColor="#475569" />
                                <TextView
                                    android:id="@+id/tvUtilityCost"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="৳0"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#1E293B"
                                    android:layout_alignParentEnd="true" />
                            </RelativeLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/pbUtility"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:progress="0"
                                app:trackThickness="5dp"
                                app:trackColor="#EDF2F7"
                                app:indicatorColor="#FFB74D"
                                app:trackCornerRadius="10dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Item 3: Bua Salary -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_members"
                            android:padding="8dp"
                            android:background="@drawable/pill_background"
                            android:backgroundTint="#E0F2F1"
                            app:tint="#26A69A" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bua salary"
                                    android:textSize="14sp"
                                    android:textColor="#475569" />
                                <TextView
                                    android:id="@+id/tvBuaCost"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="৳0"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#1E293B"
                                    android:layout_alignParentEnd="true" />
                            </RelativeLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/pbBua"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:progress="0"
                                app:trackThickness="5dp"
                                app:trackColor="#EDF2F7"
                                app:indicatorColor="#26A69A"
                                app:trackCornerRadius="10dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Item 4: Occasion Food -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_gift_box"
                            android:padding="8dp"
                            android:background="@drawable/pill_background"
                            android:backgroundTint="#F3E5F5"
                            app:tint="#9C27B0" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Occasion food"
                                    android:textSize="14sp"
                                    android:textColor="#475569" />
                                <TextView
                                    android:id="@+id/tvOccasionCost"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="৳0"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#1E293B"
                                    android:layout_alignParentEnd="true" />
                            </RelativeLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/pbOccasion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:progress="0"
                                app:trackThickness="5dp"
                                app:trackColor="#EDF2F7"
                                app:indicatorColor="#9C27B0"
                                app:trackCornerRadius="10dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Item 5: Other Expenses -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_document"
                            android:padding="8dp"
                            android:background="@drawable/pill_background"
                            android:backgroundTint="#FFEBEE"
                            app:tint="#E91E63" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Other expenses"
                                    android:textSize="14sp"
                                    android:textColor="#475569" />
                                <TextView
                                    android:id="@+id/tvOtherCost"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="৳0"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#1E293B"
                                    android:layout_alignParentEnd="true" />
                            </RelativeLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/pbOther"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:progress="0"
                                app:trackThickness="5dp"
                                app:trackColor="#EDF2F7"
                                app:indicatorColor="#E91E63"
                                app:trackCornerRadius="10dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Members Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:id="@+id/memberBreakdownContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PER MEMBER BREAKDOWN"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.05" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home"
                app:tint="#475569"
                android:contentDescription="Home" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="#475569"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_members"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_members"
                app:tint="#475569"
                android:contentDescription="Members" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Members"
                android:textSize="11sp"
                android:textColor="#475569"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_meals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_meals"
                app:tint="#475569"
                android:contentDescription="Meals" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meals"
                android:textSize="11sp"
                android:textColor="#475569"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_bazar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bazar"
                app:tint="#475569"
                android:contentDescription="Bazar" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bazar"
                android:textSize="11sp"
                android:textColor="#475569"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_cash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cash"
                app:tint="#475569"
                android:contentDescription="Cash" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cash"
                android:textSize="11sp"
                android:textColor="#475569"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_more"
                app:tint="#0D5169"
                android:contentDescription="More" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More"
                android:textSize="11sp"
                android:textColor="#0D5169"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
