<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <View
            android:id="@+id/icon_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_circle_orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_meals"
            app:layout_constraintBottom_toBottomOf="@id/icon_bg"
            app:layout_constraintEnd_toEndOf="@id/icon_bg"
            app:layout_constraintStart_toStartOf="@id/icon_bg"
            app:layout_constraintTop_toTopOf="@id/icon_bg"
            app:tint="@color/icon_orange" />

        <TextView
            android:id="@+id/tvGuestName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Guest Name"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvMealCount"
            app:layout_constraintStart_toEndOf="@id/icon_bg"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGuestDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Member Name · Meal Type · Date"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/tvGuestName"
            app:layout_constraintStart_toStartOf="@id/tvGuestName"
            app:layout_constraintTop_toBottomOf="@id/tvGuestName" />

        <TextView
            android:id="@+id/tvMealCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 Meals"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
