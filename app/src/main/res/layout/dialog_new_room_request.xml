<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Title row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="New Room Request"
                android:textColor="#0D1B2A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseRoomRequest"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />

        </RelativeLayout>

        <!-- MEMBER -->
        <TextView
            style="@style/LabelStyle"
            android:text="MEMBER" />

        <Spinner
            android:id="@+id/spinnerMember"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp" />

        <!-- ROOM -->
        <TextView
            style="@style/LabelStyle"
            android:text="ROOM" />

        <Spinner
            android:id="@+id/spinnerRoom"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp" />

        <!-- ISSUE DESCRIPTION -->
        <TextView
            style="@style/LabelStyle"
            android:text="ISSUE DESCRIPTION" />

        <EditText
            android:id="@+id/etIssueDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:hint="Describe the issue in detail..."
            android:textColorHint="#A0AAB4"
            android:textColor="#0D1B2A"
            android:textSize="15sp"
            android:inputType="textMultiLine"
            android:gravity="top" />

        <!-- PRIORITY -->
        <TextView
            style="@style/LabelStyle"
            android:text="PRIORITY" />

        <Spinner
            android:id="@+id/spinnerRequestPriority"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitNewRequest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_teal"
            android:text="Submit Request"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
