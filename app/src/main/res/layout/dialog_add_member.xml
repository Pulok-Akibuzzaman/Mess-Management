<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Title row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvMemberDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Add New Member"
                android:textColor="#0D1B2A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_close"
                android:contentDescription="Close"
                app:tint="#6B7A8D" />

        </RelativeLayout>

        <!-- FULL NAME -->
        <TextView
            style="@style/LabelStyle"
            android:text="FULL NAME" />

        <EditText
            android:id="@+id/etFullName"
            style="@style/InputStyle"
            android:hint="e.g. Lionel Messi"
            android:inputType="textPersonName" />

        <!-- ROOM NUMBER -->
        <TextView
            style="@style/LabelStyle"
            android:text="ROOM NUMBER" />

        <EditText
            android:id="@+id/etRoomNumber"
            style="@style/InputStyle"
            android:hint="e.g. 206"
            android:inputType="text" />

        <!-- CONTACT NUMBER -->
        <TextView
            style="@style/LabelStyle"
            android:text="CONTACT NUMBER" />

        <EditText
            android:id="@+id/etContact"
            style="@style/InputStyle"
            android:hint="01XXXXXXXXX"
            android:inputType="phone"
            android:maxLength="11"/>

        <!-- EMAIL -->
        <TextView
            style="@style/LabelStyle"
            android:text="EMAIL" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/InputStyle"
            android:hint="example@email.com"
            android:inputType="textEmailAddress" />

        <!-- STATUS -->
        <TextView
            style="@style/LabelStyle"
            android:text="STATUS" />

        <Spinner
            android:id="@+id/spinnerStatus"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp" />

        <!-- JOIN DATE -->
        <TextView
            style="@style/LabelStyle"
            android:text="JOIN DATE" />

        <EditText
            android:id="@+id/etJoinDate"
            style="@style/InputStyle"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="26 Jul 2025"
            android:inputType="none" />

        <!-- Add Member Button -->

        <Button
            android:id="@+id/btnAddMember"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_teal"
            android:text="Add Member"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
