<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="300dp"
    android:height="150dp"
    android:viewportWidth="300"
    android:viewportHeight="150">

    <!-- Grid Lines -->
    <path
        android:pathData="M0,30 L300,30"
        android:strokeWidth="1"
        android:strokeColor="#E2E8F0"
        android:strokeAlpha="1"
        android:strokeLineCap="round" />
    <path
        android:pathData="M0,70 L300,70"
        android:strokeWidth="1"
        android:strokeColor="#E2E8F0"
        android:strokeAlpha="1"
        android:strokeLineCap="round" />
    <path
        android:pathData="M0,110 L300,110"
        android:strokeWidth="1"
        android:strokeColor="#E2E8F0"
        android:strokeAlpha="1"
        android:strokeLineCap="round" />

    <!-- Gradient Area -->
    <path
        android:pathData="M30,120 L90,100 L150,115 L210,80 L270,65 L270,140 L30,140 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="150"
                android:startY="65"
                android:endX="150"
                android:endY="140"
                android:type="linear">
                <item android:offset="0" android:color="#33FFB74D" />
                <item android:offset="1" android:color="#00FFB74D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Trend Line -->
    <path
        android:pathData="M30,120 L90,100 L150,115 L210,80 L270,65"
        android:strokeWidth="3"
        android:strokeColor="#FFB74D"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Points -->
    <path android:fillColor="#FFB74D" android:pathData="M30,120 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0" />
    <path android:fillColor="#FFB74D" android:pathData="M90,100 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0" />
    <path android:fillColor="#FFB74D" android:pathData="M150,115 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0" />
    <path android:fillColor="#FFB74D" android:pathData="M210,80 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0" />
    <path android:fillColor="#FFB74D" android:pathData="M270,65 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0" />

</vector>